<local:MyPageRight x:Class="PCL.PageServerRight"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL">

    <!-- 没进服务器时是卡片墙 进去之后是这台服务器的分页 两者共占这块地方 -->
    <Grid Margin="25,10">
        <local:ServerWall x:Name="PanWall" />

        <Grid x:Name="PanDetail" Visibility="Collapsed">
            <!-- 首页 状态 动作 和几个一眼要看的数字 -->
            <Grid x:Name="PanHome" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <local:MyCard Grid.Row="0" Margin="0,15,0,15" Title="{DynamicResource Server.Panel.Title}">
                <StackPanel Margin="25,40,25,16">
                    <Grid Height="28">
                        <TextBlock x:Name="LabName" FontWeight="Bold" VerticalAlignment="Center"
                                   HorizontalAlignment="Left" />
                        <TextBlock x:Name="LabStatus" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Opacity="0.7" />
                    </Grid>
                    <TextBlock x:Name="LabAddress" Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap"
                               LineHeight="20" LineStackingStrategy="BlockLineHeight" />

                    <!-- 上次异常退出的原因 熔断之后用户得知道为什么起不来 -->
                    <TextBlock x:Name="LabProblem" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                               LineHeight="20" LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource ColorBrushRedLight}" />

                    <StackPanel x:Name="PanEula" Margin="0,10,0,0" Visibility="Collapsed">
                        <TextBlock Text="{DynamicResource Server.Panel.EulaHint}" TextWrapping="Wrap" Opacity="0.7"
                                   LineHeight="20" LineStackingStrategy="BlockLineHeight" />
                        <StackPanel Orientation="Horizontal" Height="35" Margin="0,8,0,0">
                            <local:MyButton x:Name="BtnEula" MinWidth="110" Padding="13,0"
                                            Text="{DynamicResource Server.Panel.EulaAccept}" Click="BtnEula_Click" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 停止态只给启动 运行态给重启 停止 强制停止 文件管理一直在最右边 -->
                    <Grid Height="35" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <local:MyButton x:Name="BtnStart" MinWidth="110" Padding="13,0"
                                            Text="{DynamicResource Server.Action.Start}" Click="BtnStart_Click" />
                            <local:MyButton x:Name="BtnRestart" MinWidth="110" Padding="13,0" Margin="16,0,0,0"
                                            Visibility="Collapsed"
                                            Text="{DynamicResource Server.Action.Restart}" Click="BtnRestart_Click" />
                            <local:MyButton x:Name="BtnStop" MinWidth="110" Padding="13,0" Margin="16,0,0,0"
                                            Visibility="Collapsed"
                                            Text="{DynamicResource Server.Action.Stop}" Click="BtnStop_Click" />
                            <local:MyButton x:Name="BtnForceStop" MinWidth="110" Padding="13,0" Margin="16,0,0,0"
                                            Visibility="Collapsed"
                                            Text="{DynamicResource Server.Action.ForceStop}"
                                            Click="BtnForceStop_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- 关掉正版验证离线登录的客户端才进得来 朋友用第三方启动器时一般要关 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Text="{DynamicResource Server.Panel.OnlineMode}" />
                        <local:MyCheckBox x:Name="CheckOnlineMode" Grid.Column="1" VerticalAlignment="Center"
                                          Text="{DynamicResource Server.Panel.OnlineMode.On}"
                                          Change="OnlineModeChange" />
                        <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7"
                                   TextWrapping="Wrap" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                                   Text="{DynamicResource Server.Panel.OnlineMode.Hint}" />
                    </Grid>
                </StackPanel>
            </local:MyCard>

                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <local:MyCard Grid.Column="0" Margin="0,0,15,0" Title="{DynamicResource Server.Home.Address}">
                        <StackPanel Margin="25,40,25,16">
                            <TextBlock x:Name="LabHomeAddress" FontSize="16" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="LabHomeAddressHint" Margin="0,6,0,0" FontSize="12" Opacity="0.6"
                                       TextWrapping="Wrap" LineHeight="18"
                                       LineStackingStrategy="BlockLineHeight" />
                        </StackPanel>
                    </local:MyCard>

                    <local:MyCard Grid.Column="1" Margin="0,0,15,0" Title="{DynamicResource Server.Home.Uptime}">
                        <StackPanel Margin="25,40,25,16">
                            <TextBlock x:Name="LabHomeUptime" FontSize="16" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="LabHomeUptimeHint" Margin="0,6,0,0" FontSize="12" Opacity="0.6"
                                       TextWrapping="Wrap" LineHeight="18"
                                       LineStackingStrategy="BlockLineHeight" />
                        </StackPanel>
                    </local:MyCard>

                    <local:MyCard Grid.Column="2" Title="{DynamicResource Server.Home.Memory}">
                        <StackPanel Margin="25,40,25,16">
                            <TextBlock x:Name="LabHomeMemory" FontSize="16" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="LabHomeMemoryHint" Margin="0,6,0,0" FontSize="12" Opacity="0.6"
                                       TextWrapping="Wrap" LineHeight="18"
                                       LineStackingStrategy="BlockLineHeight" />
                        </StackPanel>
                    </local:MyCard>
                </Grid>
            </Grid>

            <!-- 控制台 单独一页 吃掉整块高度 -->
            <local:MyCard x:Name="PanConsole" Visibility="Collapsed" Margin="0,15,0,15"
                          Title="{DynamicResource Server.Panel.Console}">
                <Grid Margin="25,40,25,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 用 ScrollViewer 包 TextBlock 而不是 TextBox TextBox 的 ScrollToEnd 在这里不生效 -->
                    <Border Grid.Row="0" MinHeight="120" Padding="12,9" CornerRadius="5"
                            Background="{DynamicResource ColorBrush7}">
                        <ScrollViewer x:Name="PanConsoleScroll" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LabConsole" TextWrapping="NoWrap"
                                       FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" />
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyTextBox x:Name="TextCommand" Grid.Column="0" Margin="0,0,9,0"
                                         HintText="{DynamicResource Server.Panel.CommandHint}" />
                        <local:MyButton x:Name="BtnSend" Grid.Column="1" MinWidth="90" Padding="13,0"
                                        Text="{DynamicResource Server.Panel.Send}" Click="BtnSend_Click" />
                    </Grid>
                </Grid>
            </local:MyCard>

            <!-- 网络配置 单独一页 内容比较高 窗口小了靠滚动 -->
            <local:MyScrollViewer x:Name="PanNetwork" Visibility="Collapsed"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource ScrollViewerFullMargin}">
            <!-- 先探直连 直连不了才走穿透 -->
            <local:MyCard Margin="0,15,0,25" Title="{DynamicResource Server.Panel.Network}">
                <StackPanel Margin="25,40,25,16">
                    <Grid Height="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Text="{DynamicResource Server.Network.Direct}" />
                        <local:MyButton x:Name="BtnProbe" Grid.Column="1" MinWidth="110" Padding="13,0"
                                        Text="{DynamicResource Server.Network.Probe}" Click="BtnProbe_Click" />
                        <TextBlock x:Name="LabProbe" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                   TextWrapping="Wrap" Opacity="0.75" />
                    </Grid>

                    <!-- 服务商 两套参数结构完全不同 用互斥面板而不是同一批输入框 -->
                    <Grid Margin="0,12,0,0" Height="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Text="{DynamicResource Server.Network.Provider}" />
                        <local:MyRadioBox Grid.Column="1" x:Name="RadioTunnelManual" Height="22" Margin="0,0,24,0"
                                          Text="{DynamicResource Server.Network.Provider.Manual}"
                                          Tag="ServerTunnelProvider/0" Check="TunnelProviderChange" />
                        <local:MyRadioBox Grid.Column="2" x:Name="RadioTunnelChmlFrp" Height="22" Margin="0,0,24,0"
                                          Text="{DynamicResource Server.Network.Provider.ChmlFrp}"
                                          Tag="ServerTunnelProvider/1" Check="TunnelProviderChange" />
                        <local:MyRadioBox Grid.Column="3" x:Name="RadioTunnelSakura" Height="22"
                                          Text="{DynamicResource Server.Network.Provider.Sakura}"
                                          Tag="ServerTunnelProvider/2" Check="TunnelProviderChange" />
                    </Grid>

                    <!-- 手动 frp -->
                    <StackPanel x:Name="PanTunnelManual" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Text="{DynamicResource Server.Network.TunnelServer}" />
                            <local:MyTextBox x:Name="TextTunnelAddress" Grid.Column="1" Margin="0,0,9,0"
                                             HintText="{DynamicResource Server.Network.AddressHint}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,9,0"
                                       Text="{DynamicResource Server.Network.Port}" />
                            <local:MyTextBox x:Name="TextTunnelPort" Grid.Column="3"
                                             HintText="{DynamicResource Server.Network.PortHint}" />
                        </Grid>

                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Text="{DynamicResource Server.Network.Token}" />
                            <local:MyTextBox x:Name="TextTunnelToken" Grid.Column="1" Margin="0,0,9,0"
                                             HintText="{DynamicResource Server.Network.TokenHint}" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,9,0"
                                       Text="{DynamicResource Server.Network.RemotePort}" />
                            <local:MyTextBox x:Name="TextTunnelRemotePort" Grid.Column="3"
                                             HintText="{DynamicResource Server.Network.PortHint}" />
                        </Grid>
                    </StackPanel>

                    <!-- ChmlFrp 隧道在它的面板里建 这里只选一条用 -->
                    <StackPanel x:Name="PanTunnelChmlFrp" Margin="0,10,0,0" Visibility="Collapsed">
                        <!-- 按钮没有固有高度 行必须给高度 不然会被压扁 -->
                        <Grid Height="35">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Text="{DynamicResource Server.Network.Account}" />
                            <TextBlock x:Name="LabChmlFrpAccount" Grid.Column="1" VerticalAlignment="Center"
                                       Opacity="0.75" TextWrapping="Wrap" />
                            <local:MyButton x:Name="BtnChmlFrpLogin" Grid.Column="2" MinWidth="110" Padding="13,0"
                                            Text="{DynamicResource Server.Network.ChmlFrp.Login}"
                                            Click="BtnChmlFrpLogin_Click" />
                            <local:MyButton x:Name="BtnChmlFrpLogout" Grid.Column="2" MinWidth="110" Padding="13,0"
                                            Visibility="Collapsed"
                                            Text="{DynamicResource Server.Network.SignOut}"
                                            Click="BtnChmlFrpLogout_Click" />
                        </Grid>

                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Text="{DynamicResource Server.Network.ChmlFrp.UserToken}" />
                            <local:MyTextBox x:Name="TextChmlFrpUser" Grid.Column="1" Grid.ColumnSpan="3"
                                             HintText="{DynamicResource Server.Network.ChmlFrp.UserTokenHint}" />
                        </Grid>

                        <Grid Height="35" Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Text="{DynamicResource Server.Network.ChmlFrp.Tunnel}" />
                            <local:MyComboBox x:Name="ComboChmlFrpTunnel" Grid.Column="1" Margin="0,0,9,0"
                                              SelectionChanged="ChmlFrpTunnelChange" />
                            <local:MyButton x:Name="BtnChmlFrpRefresh" Grid.Column="2" MinWidth="110" Padding="13,0"
                                            Margin="0,0,9,0"
                                            Text="{DynamicResource Server.Network.ChmlFrp.Refresh}"
                                            Click="BtnChmlFrpRefresh_Click" />
                            <local:MyButton x:Name="BtnChmlFrpCreate" Grid.Column="3" MinWidth="110" Padding="13,0"
                                            Text="{DynamicResource Server.Network.ChmlFrp.Create}"
                                            Click="BtnChmlFrpCreate_Click" />
                        </Grid>
                    </StackPanel>

                    <!-- 樱花 密钥在它面板的用户中心里生成 -->
                    <StackPanel x:Name="PanTunnelSakura" Margin="0,10,0,0" Visibility="Collapsed">
                        <Grid Height="35">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Text="{DynamicResource Server.Network.Sakura.Key}" />
                            <local:MyTextBox x:Name="TextSakuraKey" Grid.Column="1" Margin="0,0,9,0"
                                             HintText="{DynamicResource Server.Network.Sakura.KeyHint}" />
                            <local:MyButton x:Name="BtnSakuraRefresh" Grid.Column="2" MinWidth="110" Padding="13,0"
                                            Margin="0,0,9,0"
                                            Text="{DynamicResource Server.Network.Sakura.Refresh}"
                                            Click="BtnSakuraRefresh_Click" />
                            <local:MyButton x:Name="BtnSakuraCreate" Grid.Column="3" MinWidth="110" Padding="13,0"
                                            Text="{DynamicResource Server.Network.Sakura.Create}"
                                            Click="BtnSakuraCreate_Click" />
                        </Grid>

                        <Grid Margin="0,9,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                       Text="{DynamicResource Server.Network.ChmlFrp.Tunnel}" />
                            <local:MyComboBox x:Name="ComboSakuraTunnel" Grid.Column="1"
                                              SelectionChanged="SakuraTunnelChange" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Height="35" Margin="0,14,0,0">
                        <local:MyButton x:Name="BtnTunnelStart" MinWidth="110" Padding="13,0"
                                        Text="{DynamicResource Server.Network.TunnelStart}" Click="BtnTunnelStart_Click" />
                        <local:MyButton x:Name="BtnTunnelStop" MinWidth="110" Padding="13,0" Margin="16,0,0,0"
                                        Text="{DynamicResource Server.Network.TunnelStop}" Click="BtnTunnelStop_Click" />
                    </StackPanel>

                    <TextBlock x:Name="LabTunnel" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.75"
                               LineHeight="20" LineStackingStrategy="BlockLineHeight" />
                </StackPanel>
            </local:MyCard>
            </local:MyScrollViewer>

            <local:ServerFilePanel x:Name="PanFiles" Visibility="Collapsed" />
        </Grid>
    </Grid>
</local:MyPageRight>
