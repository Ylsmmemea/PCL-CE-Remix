<Grid x:Class="PCL.ServerFilePanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:PCL">

    <!-- 浏览界面 外层已经带了页边距 -->
    <Grid x:Name="PanBrowse">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <local:MyCard Grid.Row="0" Margin="0,15,0,15" Title="{DynamicResource Server.Files.Title}">
            <StackPanel Margin="25,40,25,16">
                <Grid Height="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                               Text="{DynamicResource Server.Files.Path}" />
                    <TextBlock x:Name="LabPath" Grid.Column="1" VerticalAlignment="Center" Opacity="0.75"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <!-- 按钮没有固有高度 行必须给高度 不然会被压扁 -->
                <StackPanel Orientation="Horizontal" Height="35" Margin="0,14,0,0">
                    <local:MyButton x:Name="BtnUp" MinWidth="110" Padding="13,0"
                                    Text="{DynamicResource Server.Files.Up}" Click="BtnUp_Click" />
                    <local:MyButton x:Name="BtnRefresh" MinWidth="110" Padding="13,0" Margin="16,0,0,0"
                                    Text="{DynamicResource Server.Files.Refresh}" Click="BtnRefresh_Click" />
                    <local:MyButton x:Name="BtnNewFolder" MinWidth="110" Padding="13,0" Margin="16,0,0,0"
                                    Text="{DynamicResource Server.Files.NewFolder}" Click="BtnNewFolder_Click" />
                    <local:MyButton x:Name="BtnUpload" MinWidth="110" Padding="13,0" Margin="16,0,0,0"
                                    Text="{DynamicResource Server.Files.Upload}" Click="BtnUpload_Click" />
                </StackPanel>
            </StackPanel>
        </local:MyCard>

        <local:MyCard Grid.Row="1" Margin="0,0,0,15" Title="{DynamicResource Server.Files.List}">
            <Grid Margin="25,40,25,16">
                <local:MyScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                      Style="{StaticResource ScrollViewerFullMargin}">
                    <StackPanel x:Name="PanList" Margin="0,0,0,20" />
                </local:MyScrollViewer>
                <TextBlock x:Name="LabEmpty" Text="{DynamicResource Server.Files.Empty}" Margin="13,6,13,0"
                           Opacity="0.5" TextWrapping="Wrap" Visibility="Collapsed" />
            </Grid>
        </local:MyCard>
    </Grid>

    <!-- 编辑浮层 盖住整个面板 免得点到后面的列表 -->
    <Grid x:Name="PanEditor" Visibility="Collapsed" Background="#66000000">
        <local:MyCard x:Name="CardEditor" Margin="25" Title="{DynamicResource Server.Files.Edit}">
            <Grid Margin="25,40,25,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <local:MyTextBox x:Name="TextEditor" Grid.Row="0" AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="NoWrap" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Height="35" Margin="0,9,0,0">
                    <local:MyButton x:Name="BtnEditorSave" MinWidth="110" Padding="13,0"
                                    Text="{DynamicResource Server.Files.Save}" Click="BtnEditorSave_Click" />
                    <local:MyButton x:Name="BtnEditorCancel" MinWidth="110" Padding="13,0" Margin="16,0,0,0"
                                    Text="{DynamicResource Common.Action.Cancel}" Click="BtnEditorCancel_Click" />
                    <TextBlock x:Name="LabEditor" VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.75"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </local:MyCard>
    </Grid>
</Grid>
